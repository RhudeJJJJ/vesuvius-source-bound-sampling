index 0000000..168fcd0
--- /dev/null
+++ b/vesuvius/src/vesuvius/ink_detection/source_identity.py
@@ -0,0 +1,194 @@
+"""Check fixed-prior groups against a separately recorded publisher source table.
+
+This module uses only the standard library and never opens volumes or fetches
+URLs. A source identity is the publisher's (scroll, segment) path, not a name
+inferred from a local label folder or an authored physical-segment key.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import defaultdict
+import json
+from pathlib import Path
+from typing import Any, Mapping
+from urllib.parse import urlsplit
+
+
+_CONFIGS = Path(__file__).with_name("configs")
+
+
+class SourceIdentityError(ValueError):
+    """The config or its source-reference partition is inconsistent."""
+
+
+def _string(row: Mapping[str, Any], name: str) -> str:
+    value = row.get(name)
+    if not isinstance(value, str) or not value.strip():
+        raise SourceIdentityError(f"{name} must be a nonempty string")
+    return value
+
+
+def source_identity_from_link(link: str) -> tuple[str, str]:
+    """Read a publisher index link's scroll/segment path, ignoring scan choice."""
+    url = urlsplit(link)
+    parts = url.fragment.strip("/").split("/")
+    if (
+        url.scheme != "https"
+        or url.netloc != "vesuvius-challenge-open-data.s3.amazonaws.com"
+        or url.path != "/index.html"
+        or url.query
+        or len(parts) != 5
+        or parts[1] != "segments"
+        or parts[3] != "surface-volumes"
+        or not all(parts)
+        or any(part in {".", ".."} for part in parts)
+        or not parts[4].endswith(".zarr")
+    ):
+        raise SourceIdentityError(f"invalid publisher surface-volume link: {link!r}")
+    return parts[0], parts[2]
+
+
+def _config_rows(config: Mapping[str, Any]) -> list[dict[str, Any]]:
+    if "representations" in config and "datasets" not in config:
+        rows = config["representations"]
+        if not isinstance(rows, list) or not all(isinstance(row, dict) for row in rows):
+            raise SourceIdentityError("representations must be a list of objects")
+        return rows
+    if "datasets" in config and "representations" not in config:
+        datasets = config["datasets"]
+        if not isinstance(datasets, list):
+            raise SourceIdentityError("datasets must be a list of objects")
+        rows = []
+        for dataset in datasets:
+            if not isinstance(dataset, dict):
+                raise SourceIdentityError("datasets must be a list of objects")
+            segments = dataset.get("segments")
+            if not isinstance(segments, list):
+                raise SourceIdentityError("each dataset needs an explicit segments list")
+            physical = dataset.get("sampling_physical_segment_keys")
+            representation = dataset.get("sampling_representation_keys")
+            if not isinstance(physical, dict) or not isinstance(representation, dict):
+                raise SourceIdentityError("each dataset needs explicit sampling key maps")
+            if len(set(segments)) != len(segments):
+                raise SourceIdentityError("duplicate segment in dataset")
+            if set(physical) != set(segments) or set(representation) != set(segments):
+                raise SourceIdentityError("sampling key maps must cover exactly the dataset segments")
+            rows.extend(
+                {
+                    "segment": segment,
+                    "scroll": dataset.get("sampling_scroll"),
+                    "physical_segment_key": physical[segment],
+                    "representation_key": representation[segment],
+                }
+                for segment in segments
+            )
+        return rows
+    raise SourceIdentityError("config must contain representations or datasets, exclusively")
+
+
+def validate_source_identity(
+    config: Mapping[str, Any], manifest: Mapping[str, Any]
+) -> dict[str, int]:
+    """Require exact representation coverage and equal source/physical partitions.
+
+    Physical key strings stay opaque. Equal source paths must share a key;
+    distinct source paths must not share one. Thus a mutually consistent pair
+    of bad configs fails, and arbitrary one-to-one renaming of keys succeeds.
+    The check establishes the recorded publisher assignments, not geometric
+    equivalence, data availability, or historical training behavior.
+    """
+    if manifest.get("schema_version") != 1:
+        raise SourceIdentityError("unsupported source manifest schema_version")
+    reference_rows = manifest.get("representations")
+    if not isinstance(reference_rows, list) or not reference_rows:
+        raise SourceIdentityError("source manifest needs a nonempty representations list")
+    reference = {}
+    for row in reference_rows:
+        if not isinstance(row, dict):
+            raise SourceIdentityError("source representations must be objects")
+        key = _string(row, "representation_key")
+        if key in reference:
+            raise SourceIdentityError(f"duplicate source representation: {key}")
+        reference[key] = (
+            _string(row, "segment"),
+            _string(row, "scroll"),
+            source_identity_from_link(_string(row, "source_link")),
+        )
+
+    configured = {}
+    for row in _config_rows(config):
+        key = _string(row, "representation_key")
+        if key in configured:
+            raise SourceIdentityError(f"duplicate configured representation: {key}")
+        configured[key] = (
+            _string(row, "segment"),
+            _string(row, "scroll"),
+            _string(row, "physical_segment_key"),
+        )
+    missing = sorted(reference.keys() - configured.keys())
+    unknown = sorted(configured.keys() - reference.keys())
+    if missing or unknown:
+        raise SourceIdentityError(f"representation coverage mismatch: missing={missing}, unknown={unknown}")
+
+    source_to_physical = defaultdict(set)
+    physical_to_source = defaultdict(set)
+    source_to_representations = defaultdict(list)
+    for key, (segment, scroll, physical) in configured.items():
+        expected_segment, expected_scroll, source = reference[key]
+        if (segment, scroll) != (expected_segment, expected_scroll):
+            raise SourceIdentityError(f"source row mismatch for {key}: segment/scroll changed")
+        source_to_physical[source].add(physical)
+        physical_to_source[physical].add(source)
+        source_to_representations[source].append(key)
+
+    errors = []
+    for source, physical_keys in sorted(source_to_physical.items()):
+        if len(physical_keys) != 1:
+            errors.append(
+                f"split source {source}: physical keys {sorted(physical_keys)} for "
+                f"{sorted(source_to_representations[source])}"
+            )
+    for physical, sources in sorted(physical_to_source.items()):
+        if len(sources) != 1:
+            errors.append(f"merged distinct sources under {physical}: {sorted(sources)}")
+    if errors:
+        raise SourceIdentityError("; ".join(errors))
+    return {
+        "representations": len(configured),
+        "source_segments": len(source_to_physical),
+        "physical_groups": len(physical_to_source),
+        "paired_source_segments": sum(len(keys) > 1 for keys in source_to_representations.values()),
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("configs", nargs="*", type=Path, help="prior or training JSONs (default: shipped aligned21 pair)")
+    parser.add_argument("--manifest", type=Path, default=_CONFIGS / "aligned21_source_identity.json")
+    args = parser.parse_args(argv)
+    paths = args.configs or [
+        _CONFIGS / "aligned21_fixed_scroll_prior.json",
+        _CONFIGS / "aligned21_hybrid_3d2d.json",
+    ]
+    reports = []
+    try:
+        manifest = json.loads(args.manifest.read_text(encoding="utf-8"))
+        if not isinstance(manifest, dict):
+            raise SourceIdentityError("source manifest must be an object")
+        for path in paths:
+            try:
+                config = json.loads(path.read_text(encoding="utf-8"))
+                if not isinstance(config, dict):
+                    raise SourceIdentityError("config must be an object")
+                reports.append({"config": str(path), "valid": True, **validate_source_identity(config, manifest)})
+            except (OSError, ValueError, TypeError) as exc:
+                reports.append({"config": str(path), "valid": False, "error": str(exc)})
+    except (OSError, ValueError, TypeError) as exc:
+        reports.append({"manifest": str(args.manifest), "valid": False, "error": str(exc)})
+    print(json.dumps(reports, indent=2))
+    return 0 if all(report["valid"] for report in reports) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
