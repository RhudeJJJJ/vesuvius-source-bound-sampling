+"""Regression witnesses against source splits, false merges, and shared errors."""
+
+from collections import Counter
+from copy import deepcopy
+import json
+from pathlib import Path
+
+import pytest
+
+from vesuvius.ink_detection.source_identity import (
+    SourceIdentityError,
+    main,
+    source_identity_from_link,
+    validate_source_identity,
+)
+
+
+_CONFIGS = Path(__file__).parents[2] / "src" / "vesuvius" / "ink_detection" / "configs"
+_NAMES = ("aligned21_fixed_scroll_prior.json", "aligned21_hybrid_3d2d.json")
+_MANIFEST = "aligned21_source_identity.json"
+
+
+def _load(name):
+    return json.loads((_CONFIGS / name).read_text(encoding="utf-8"))
+
+
+def _change_physical(config, segment, physical):
+    if "representations" in config:
+        next(row for row in config["representations"] if row["segment"] == segment)[
+            "physical_segment_key"
+        ] = physical
+    else:
+        next(source for source in config["datasets"] if segment in source["segments"])[
+            "sampling_physical_segment_keys"
+        ][segment] = physical
+
+
+@pytest.mark.parametrize("name", _NAMES)
+def test_shipped_groups_match_independent_publisher_source_assignments(name):
+    assert validate_source_identity(_load(name), _load(_MANIFEST)) == {
+        "representations": 29,
+        "source_segments": 24,
+        "physical_groups": 24,
+        "paired_source_segments": 5,
+    }
+
+
+def test_manifest_records_all_five_pairs_and_distinct_scan_links():
+    rows = _load(_MANIFEST)["representations"]
+    groups = Counter(source_identity_from_link(row["source_link"]) for row in rows)
+    assert sorted(groups.values()) == [1] * 19 + [2] * 5
+    paired = [row for row in rows if row["segment"] in {"pherc0139-w028", "w044"}]
+    assert len({row["representation_key"] for row in paired}) == 2
+    assert len({row["source_link"] for row in paired}) == 2
+    assert {source_identity_from_link(row["source_link"]) for row in paired} == {
+        ("PHerc0139", "20260115000000-w044_2026011522")
+    }
+
+
+@pytest.mark.parametrize("name", _NAMES)
+def test_original_alias_split_fails_even_when_both_configs_make_the_same_error(name):
+    config = _load(name)
+    _change_physical(config, "pherc0139-w028", "0139:w028")
+    with pytest.raises(SourceIdentityError, match="split source.*w044"):
+        validate_source_identity(config, _load(_MANIFEST))
+
+
+@pytest.mark.parametrize("name", _NAMES)
+def test_false_merge_of_distinct_publisher_segments_fails(name):
+    config = _load(name)
+    _change_physical(config, "pherc0139-w016", "0139:w017")
+    with pytest.raises(SourceIdentityError, match="merged distinct sources"):
+        validate_source_identity(config, _load(_MANIFEST))
+
+
+def test_equal_total_group_count_does_not_hide_split_and_merge():
+    config = _load(_NAMES[0])
+    _change_physical(config, "pherc0139-w028", "0139:w028")
+    _change_physical(config, "pherc0139-w016", "0139:w017")
+    assert len({row["physical_segment_key"] for row in config["representations"]}) == 24
+    with pytest.raises(SourceIdentityError) as error:
+        validate_source_identity(config, _load(_MANIFEST))
+    assert "split source" in str(error.value)
+    assert "merged distinct sources" in str(error.value)
+
+
+def test_physical_keys_are_opaque_and_do_not_need_to_match_folder_names():
+    config = _load(_NAMES[0])
+    replacements = {
+        physical: f"opaque-{index}"
+        for index, physical in enumerate(
+            sorted({row["physical_segment_key"] for row in config["representations"]})
+        )
+    }
+    for row in config["representations"]:
+        row["physical_segment_key"] = replacements[row["physical_segment_key"]]
+    assert validate_source_identity(config, _load(_MANIFEST))["physical_groups"] == 24
+
+
+@pytest.mark.parametrize("field", ["segment", "scroll"])
+def test_recorded_source_row_cannot_be_reassigned(field):
+    config = _load(_NAMES[0])
+    config["representations"][0][field] = "unrecorded"
+    with pytest.raises(SourceIdentityError, match="source row mismatch"):
+        validate_source_identity(config, _load(_MANIFEST))
+
+
+def test_missing_and_unknown_representation_are_both_reported():
+    config = _load(_NAMES[0])
+    config["representations"][0]["representation_key"] = "unrecorded"
+    with pytest.raises(SourceIdentityError) as error:
+        validate_source_identity(config, _load(_MANIFEST))
+    assert "missing=['public_2p4_level2_zmean4:pherc0139-w016']" in str(error.value)
+    assert "unknown=['unrecorded']" in str(error.value)
+
+
+@pytest.mark.parametrize("which", ["config", "manifest"])
+def test_duplicate_representations_are_rejected(which):
+    config, manifest = _load(_NAMES[0]), _load(_MANIFEST)
+    target = config if which == "config" else manifest
+    target["representations"].append(deepcopy(target["representations"][0]))
+    with pytest.raises(SourceIdentityError, match="duplicate.*representation"):
+        validate_source_identity(config, manifest)
+
+
+@pytest.mark.parametrize("extra", [False, True])
+def test_training_key_maps_require_exact_segment_coverage(extra):
+    config = _load(_NAMES[1])
+    mapping = config["datasets"][0]["sampling_physical_segment_keys"]
+    if extra:
+        mapping["unrecorded"] = "opaque"
+    else:
+        del mapping["pherc0139-w028"]
+    with pytest.raises(SourceIdentityError, match="cover exactly"):
+        validate_source_identity(config, _load(_MANIFEST))
+
+
+@pytest.mark.parametrize(
+    "link",
+    [
+        "https://example.org/no-source",
+        "https://example.org/#a/segments/../surface-volumes/x.zarr",
+        "file:///tmp/source.zarr",
+        "https://example.org/index.html#PHerc0139/segments/w044/surface-volumes/x.zarr/",
+        "https://vesuvius-challenge-open-data.s3.amazonaws.com/other.html#PHerc0139/segments/w044/surface-volumes/x.zarr/",
+    ],
+)
+def test_missing_publisher_identity_has_no_name_based_fallback(link):
+    manifest = _load(_MANIFEST)
+    manifest["representations"][0]["source_link"] = link
+    with pytest.raises(SourceIdentityError, match="invalid publisher"):
+        validate_source_identity(_load(_NAMES[0]), manifest)
+
+
+def test_cli_reports_each_config_and_returns_nonzero_for_a_split(tmp_path, capsys):
+    config = _load(_NAMES[0])
+    _change_physical(config, "pherc0139-w028", "0139:w028")
+    broken = tmp_path / "split.json"
+    broken.write_text(json.dumps(config), encoding="utf-8")
+    assert main([str(_CONFIGS / _NAMES[1]), str(broken)]) == 1
+    reports = json.loads(capsys.readouterr().out)
+    assert reports[0]["valid"] is True
+    assert reports[0]["source_segments"] == 24
+    assert reports[1]["valid"] is False
+    assert "split source" in reports[1]["error"]
